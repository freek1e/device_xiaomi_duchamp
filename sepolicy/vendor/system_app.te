# DisplayFeature
hal_client_domain(system_app, vendor_hal_displayfeature)
binder_call(system_app, vendor_hal_displayfeature)

# Thermal
rw_dir_file(system_app, sysfs_therm)

# Tile
allow system_app sysfs_therm:file { write };
allow system_app sysfs_therm:file { getattr open read };

# Turbo Charge
allow system_app sysfs_power_supply:file rw_file_perms;
allow system_app sysfs_power_supply:dir search;
allow system_app sysfs_power_supply:file { write setattr };
allow system_app self:netlink_kobject_uevent_socket { bind create read setopt };
allow system_app sysfs_power_supply:file { write setattr };

# Core Control
allow system_app vendor_sysfs_corecontrol:dir search;
allow system_app vendor_sysfs_corecontrol:file { getattr open read write };
allow system_app vendor_sysfs_corecontrol:file rw_file_perms;

# Touch Sampling
allow system_app vendor_sysfs_htsr:file rw_file_perms;
allow system_app hal_touchfeature_xiaomi_service:service_manager find;
binder_call(system_app, hal_touchfeature_xiaomi_service)
binder_call(system_app, hal_touchfeature_xiaomi_default)
allow system_app init:unix_stream_socket connectto;

# Extra 
binder_call(system_app, vendor_hal_displayfeature_xiaomi_default)
allow system_app hal_touchfeature_xiaomi_service:service_manager find;
binder_call(system_app, hal_touchfeature_xiaomi)


