typeattribute platform_app hal_camera_client;
typeattribute platform_app hal_graphics_allocator_client;
typeattribute platform_app vendor_hal_citsensorservice_xiaomi_client;
binder_call(platform_app, mtk_hal_camera)
get_prop(platform_app, vendor_mtk_camera_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_display_type_prop)
get_prop(platform_app, vendor_us_proximity_prop)

allow platform_app {
    app_api_service
    audioserver_service
    cameraserver_service
    hal_camera_service
    mediaextractor_service
    mediametrics_service
    mediaserver_service
}:service_manager find;

dontaudit platform_app radio_service:service_manager find;
allow platform_app apusys_device:chr_file rw_file_perms;
allow platform_app ion_device:chr_file rw_file_perms;
allow platform_app unlabeled:filesystem getattr;
allow platform_app shell_data_file:dir search;
r_dir_file(platform_app, vendor_camera_data_file)
allow platform_app privapp_data_file:file execute;
get_prop(platform_app, vendor_display_type_prop)
get_prop(platform_app, vendor_us_proximity_prop)