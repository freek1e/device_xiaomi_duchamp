set_prop(vendor_init, vendor_sensors_prop)
set_prop(vendor_init, vendor_batterysecret_prop)
set_prop(vendor_init, vendor_displayfeature_prop)
set_prop(vendor_init, vendor_fingerprint_prop)

allow vendor_init default_prop:property_service set;
allow vendor_init exported_system_prop:property_service set;
allow vendor_init vendor_us_proximity_prop:property_service set;
allow vendor_init vendor_userdir_file:dir write;
allow vendor_init vendor_userdir_file:dir add_name;